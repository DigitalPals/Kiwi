# Settings for compose.yaml. Copy this file to .env and fill it in; .env holds a secret and
# is never committed (see .gitignore).

# A Tailscale auth key (admin console › Settings › Keys). Only the first start uses it; after
# that the node's state in the tailscale-state volume is enough. Leave it empty to log in
# with the link that `docker compose logs tailscale` shows instead.
#
# Who owns Kiwi follows from the key:
# - a key without tags: the node belongs to you, and Kiwi takes you as its owner;
# - a tagged key: the node belongs to no user, so set KIWI_OWNER below.
TS_AUTHKEY=

# Kiwi's name on your tailnet: it answers at https://<TS_HOSTNAME>.<your tailnet>.ts.net
TS_HOSTNAME=kiwi

# Your Tailscale login (you@example.com). Required with a tagged auth key; optional
# otherwise.
KIWI_OWNER=
