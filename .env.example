# Settings for compose.yaml. Copy this file to a .env only you can read:
#
#   install -m 600 .env.example .env
#
# .env holds a secret and is never committed (see .gitignore).

# A Tailscale auth key (admin console › Settings › Keys). Make it a one-off key (Reusable
# off) that is not Ephemeral: an ephemeral machine is removed from your tailnet when it
# goes offline, and Kiwi's address with it. Only the first start uses the key (TS_AUTH_ONCE):
# after that the node's state in the tailscale-state volume is enough, so clear it here once
# Kiwi runs, and run `docker compose up -d` again. Leave it empty to log in with the link
# that `docker compose logs tailscale` shows instead (docs/install.md, "Docker").
#
# Who owns Kiwi follows from the key:
# - a key without tags: the node belongs to you, and Kiwi takes you as its owner;
# - a tagged key: the node belongs to no user, so set KIWI_OWNER below.
TS_AUTHKEY=

# Kiwi's name on your tailnet: it answers at https://<TS_HOSTNAME>.<your tailnet>.ts.net
TS_HOSTNAME=kiwi

# Your Tailscale login (you@example.com). Required with a tagged auth key; optional
# otherwise.
KIWI_OWNER=
