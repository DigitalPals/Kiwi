<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Kiwi's Mac builder LaunchAgent (template). install.sh in builder mode fills in the @...@
  values and installs the result as ~/Library/LaunchAgents/local.kiwi-builder.plist in your
  GUI (Aqua) session, where ipatool's App Store session (login keychain), UnfairPlay and
  Xcode's tools work as they do for Kiwi itself. It is separate from Kiwi's own LaunchAgent
  (local.kiwi): both can run on one Mac.

  The builder connects out to the paired Kiwi (builder.json in its data directory) and runs
  only its own runner.py. /bin/sh records the PID for log rotation
  (/etc/newsyslog.d/kiwi-builder.conf sends SIGTERM after rotating; launchd restarts the
  builder, which reopens its log) and then execs it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.kiwi-builder</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>-c</string>
		<string>echo $$ &gt;"@HOME@/Library/Logs/kiwi-builder.pid"; exec "$@"</string>
		<string>kiwi-builder</string>
		<string>@HOME@/Library/Application Support/Kiwi Builder/app/kiwi</string>
		<string>builder</string>
		<string>run</string>
		<string>--data-dir</string>
		<string>@HOME@/Library/Application Support/Kiwi Builder</string>
	</array>
	<key>WorkingDirectory</key>
	<string>@HOME@/Library/Application Support/Kiwi Builder</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
		<key>RUST_LOG</key>
		<string>info</string>
		<!-- Plain text log (no ANSI colors) -->
		<key>NO_COLOR</key>
		<string>1</string>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Standard</string>
	<key>RunAtLoad</key>
	<true/>
	<!-- Always running: restarted after a crash and after the SIGTERM that follows log rotation. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>15</integer>
	<!-- On SIGTERM it stops a running build (5 s) and tells Kiwi. -->
	<key>ExitTimeOut</key>
	<integer>30</integer>
	<!-- 077: data, logs and the PID file are private to you. -->
	<key>Umask</key>
	<integer>63</integer>
	<key>StandardOutPath</key>
	<string>@HOME@/Library/Logs/kiwi-builder.log</string>
	<key>StandardErrorPath</key>
	<string>@HOME@/Library/Logs/kiwi-builder.log</string>
</dict>
</plist>
